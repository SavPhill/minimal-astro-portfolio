---
import BaseLayout from '../layouts/BaseLayout.astro';

const strategistSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Phill Savage",
  "url": "https://psavage.net",
  "image": "https://psavage.net/images/phill.jpg",
  "description": "Designing corporate retreats in Thailand and virtual team building that help distributed teams reconnect.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chiang Mai",
    "addressCountry": "TH"
  },
  "sameAs": [
    "https://acemsthailand.com",
    "https://unboringteams.com",
    "https://x.com/savphill",
    "https://th.linkedin.com/in/phill-savage"
  ]
};
---

<BaseLayout
  title="Phill Savage"
  description="Corporate retreats in Thailand and virtual team building that help distributed teams reconnect. Security research and open-source contributions."
  keywords={["Corporate Retreats", "Offsite Planning", "Virtual Team Building", "Team Facilitation", "Chiang Mai", "Thailand", "Security Research"]}
  schema={strategistSchema}
>
  <div class="min-h-[80vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 py-20 text-left">

      <img
        src="/images/phill.jpg"
        alt="Phill Savage"
        width="88"
        height="88"
        class="w-20 h-20 rounded-full object-cover mb-6 ring-1 ring-slate-200 dark:ring-slate-700"
      />

      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">
        Phill Savage
      </h1>

     <div class="space-y-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
  <p>Hello, I'm Phill. I live in Thailand.</p>
  <p>I used to work in website development and cybersecurity. My best finds include
    <a href="https://www.cve.org/CVERecord?id=CVE-2025-58674" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">CVE-2025-58674</a> in WordPress core,
    <a href="https://www.cve.org/CVERecord?id=CVE-2025-26762" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">CVE-2025-26762</a> in WooCommerce, and
    <a href="https://www.cve.org/CVERecord?id=CVE-2024-12853" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">CVE-2024-12853</a> in Modula (CVSS 8.8). <a href="/security" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">See the full list</a>.</p>
  <p>These days I help remote teams get in the same room. I created <a href="https://offsitethailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Offsite Thailand</a>, and along with <a href="https://boutiqthailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Boutiq Hospitality</a>, we design corporate retreats that help distributed teams actually reconnect.</p>
  <p>For teams that can't meet in person, I also run <a href="https://unboringteams.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Unboring Teams</a>, offering virtual team building and facilitation.</p>
</div>


      <div class="my-6 space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Is your remote team due for an offsite?</p>
        <div class="flex flex-wrap gap-2" id="checklist">
          <button data-weight="1" class="check-btn px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 transition-all cursor-pointer">
            😴 Zoom Fatigue
          </button>
          <button data-weight="1" class="check-btn px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 transition-all cursor-pointer">
            🙋 New Hires Never Met
          </button>
          <button data-weight="1" class="check-btn px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-400 transition-all cursor-pointer">
            📉 Roadmaps Stalled
          </button>
        </div>
        <p id="score-text" class="text-xs text-slate-500 font-mono italic">Select items above to check score...</p>
      </div>

      <div class="flex items-center gap-5 mt-8 text-sm font-medium text-slate-500 dark:text-slate-400">
        <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">Say hi</a>
        <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">LinkedIn</a>
        <a href="https://x.com/savphill" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">X</a>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const btns = document.querySelectorAll('.check-btn');
  const scoreText = document.getElementById('score-text');
  let selectedCount = 0;

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('bg-slate-900');
      btn.classList.toggle('text-white');
      btn.classList.toggle('dark:bg-white');
      btn.classList.toggle('dark:text-slate-900');

      selectedCount = document.querySelectorAll('.check-btn.bg-slate-900, .check-btn.dark\\:bg-white').length;

      if (scoreText) {
        if (selectedCount === 0) scoreText.textContent = "Select items above to check score...";
        else if (selectedCount === 1) scoreText.textContent = "Status: Time to start planning a retreat.";
        else if (selectedCount === 2) scoreText.textContent = "Status: High priority — your team needs in-person alignment.";
        else if (selectedCount === 3) scoreText.textContent = "Status: Critical — book flights to Chiang Mai immediately ✈️";
      }
    });
  });
</script>