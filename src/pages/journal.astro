---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListWithThumbnails from '../components/PostListWithThumbnails.astro';
import { getCollection } from 'astro:content';

// Get all blog posts and sort them by date
const allPosts = await getCollection('posts');

// Temporarily loop current GEO-focused posts out of the main feed.
// Existing posts remain live at their original URLs; new posts will appear here.
// To re-include a post later, remove it from this archived list or add an `archived` frontmatter flag.
const archivedSlugs = [
  'ai-search-failing-brand',
  'ai-search-optimization',
  'ai-seo-specialist',
  'ai-workflow-automation',
  'b2b-lead-gen-chiangmai',
  'cheap-website-roi',
  'chiang-mai-technical-seo-agency',
  'chrome-auto-browse',
  'cost-of-geo',
  'digital-marketing-agency-problems',
  'enterprise-web-strategy-chiang-mai',
  'generative-citations',
  'generative-search-infrastructure',
  'geo-vs-seo-generative-engine-optimization-guide',
  'inside-ai-audit',
  'llm-seo-consultant',
  'seo-agency-chiangmai',
  'website-development-roi',
  'where-to-start',
  'whoami',
  'why-website-projects-go-off-the-rails-scope-creep-explained',
  'why-your-business-must-be-found-by-ai',
  'wordpress-to-astro',
];

const activePosts = allPosts.filter(post => !archivedSlugs.includes(post.id));
const sortedPosts = activePosts.sort((a, b) => {
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

// Format posts for the PostList component
const posts = sortedPosts.map(post => ({
  ...post,
  url: `/posts/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout 
  title="Notes" 
  description="Occasional notes on remote work, digital strategy, and related topics."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    
    <!-- Publication Header -->
    <header class="pt-10 mb-12 border-b border-slate-200 dark:border-slate-800 pb-12" transition:animate="fade">
      
      <!-- Kicker/Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm font-bold tracking-widest uppercase mb-6">
        Notes
      </div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6">
        Notes
      </h1>
      
      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        Occasional thoughts on remote teams, digital work, and whatever else is on my mind. Older technical posts are still available if you have the link.
      </p>
      
      <!-- Optional: Post Counter -->
      <div class="mt-8 text-sm font-medium text-slate-400 dark:text-slate-500">
        {posts.length} published notes
      </div>
    </header>

    <!-- Post Feed -->
    <div transition:animate="fade">
      {posts.length > 0 ? (
        <PostListWithThumbnails 
          posts={posts} 
          showTags={true} 
        />
      ) : (
        <p class="text-slate-500 dark:text-slate-400 text-lg">
          No notes published yet. Check back soon.
        </p>
      )}
    </div>
    
  </div>
</BaseLayout>