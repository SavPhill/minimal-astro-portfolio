---
import BaseLayout from '../layouts/BaseLayout.astro';

const consultingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Web Strategy & Organic Lead Generation Consulting",
  "serviceType": "Technical Web Strategy & SEO Advisory",
  "provider": {
    "@type": "Organization",
    "name": "Ace Marketing Solutions",
    "url": "https://acemsthailand.com"
  },
  "areaServed": [
    "Global",
    "United States",
    "Europe",
    "Asia-Pacific",
    "Thailand"
  ],
  "description": "Strategic consulting for website development, technical SEO, and organic lead generation systems by Phill Savage."
};
---

<BaseLayout 
  title="Web Strategy & Organic Lead Generation Consulting | Phill Savage" 
  description="Hire Phill Savage for web development strategy, technical SEO, and organic lead generation systems. 10+ years experience guiding digital growth and agency operations."
  keywords={["Web Strategy Consultant", "Organic Lead Generation", "Technical SEO Consultant", "Website Development Advisory", "Phill Savage", "Ace Marketing Solutions"]}
  schema={consultingSchema}
>
  <div class="relative overflow-hidden">
    <!-- Ambient Background FX -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-500/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/3 -right-40 w-96 h-96 bg-cyan-500/10 dark:bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 relative z-10">
      
      <!-- HERO HEADER -->
      <header class="pt-8 md:pt-14 mb-10" transition:animate="fade">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 mb-6 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono font-medium text-slate-700 dark:text-slate-300">
            Available for Select Strategic Engagements
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl mb-6 font-black tracking-tight text-slate-900 dark:text-white leading-[1.1]">
          Website strategy & <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-500 to-teal-400 dark:from-blue-400 dark:via-cyan-300 dark:to-teal-300">
            organic lead generation.
          </span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          I help businesses turn their websites into reliable sales assets. As Director at <a href="https://acemsthailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-600 font-semibold">Ace Marketing Solutions</a>, I consult on web architecture, search visibility, and inbound conversion pathways that bring in qualified leads.
        </p>
      </header>

      <!-- PROSE EXPLANATION -->
      <div class="prose prose-lg dark:prose-invert max-w-3xl mb-12 text-slate-700 dark:text-slate-300 leading-relaxed" transition:animate="fade">
        <p>
          Parallel to my work running corporate retreats at <a href="https://offsitethailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-600">Offsite Thailand</a>, I remain actively available for select consulting projects. 
        </p>
        <p>
          Most company websites suffer from one of two flaws: either they look great but get zero organic traffic, or they bring in visits that never convert into actual revenue. Having spent over a decade guiding web builds for brands ranging from hospitality groups like Hyatt to technical SaaS companies, my focus is bridging that gap.
        </p>
        <p>
          Whether you need to overhaul an underperforming website, build a modern fast-loading web stack, or map out an organic search strategy that captures real buyer intent, I offer direct advisory backed by full execution capabilities through Ace Marketing Solutions.
        </p>
      </div>

      <!-- CORE CONSULTING TRACKS -->
      <section class="py-12 border-t border-slate-200/60 dark:border-slate-800/60" transition:animate="fade">
        <div class="mb-8">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-600 dark:text-blue-400 font-bold">// How I Can Help</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Core Consulting Areas</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 hover:border-blue-500/50 transition-all">
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider block mb-1">// 01</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Website Architecture & Development Strategy</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              Planning fast, clean, and maintainable web builds. Fixing slow page speeds, bad UX, bloated content management setups, and security vulnerabilities before they cost you sales.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 hover:border-blue-500/50 transition-all">
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider block mb-1">// 02</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Organic Lead Generation & Search Strategy</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              Structuring technical SEO, content strategy, and schema data so your business shows up where prospective clients are actively searching—in both Google and modern AI answer engines.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 hover:border-blue-500/50 transition-all">
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider block mb-1">// 03</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Conversion Optimization & Landing Pages</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              Aligning page messaging, layout structure, and call-to-actions so visitors take action. Turning raw traffic into direct inquiries and qualified sales meetings.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 hover:border-blue-500/50 transition-all">
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider block mb-1">// 04</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Technical Web & Agency Leadership</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              Acting as a strategic advisor for founders or in-house marketing teams who need senior web expertise to guide technical decisions, vet vendors, or oversee major site relaunches.
            </p>
          </div>
        </div>
      </section>

      <!-- ENGAGEMENT PROCESS -->
      <section class="py-12 border-t border-slate-200/60 dark:border-slate-800/60" transition:animate="fade">
        <div class="mb-8">
          <span class="text-xs font-mono uppercase tracking-widest text-blue-600 dark:text-blue-400 font-bold">// Process</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">How we work together</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 font-mono text-xs">
          <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-blue-600 dark:text-blue-400 font-black text-sm mb-2">01 / AUDIT</div>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-sans text-xs">A comprehensive review of your current website, search positioning, and lead conversion leaks.</p>
          </div>

          <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-blue-600 dark:text-blue-400 font-black text-sm mb-2">02 / PLAN</div>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-sans text-xs">A clear strategy covering technical fixes, key search terms, page UX, and content messaging.</p>
          </div>

          <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-blue-600 dark:text-blue-400 font-black text-sm mb-2">03 / BUILD</div>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-sans text-xs">Hands-on technical implementation or direct guidance for your internal developers and designers.</p>
          </div>

          <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-blue-600 dark:text-blue-400 font-black text-sm mb-2">04 / GROW</div>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-sans text-xs">Ongoing optimization, monitoring inbound lead flow, and building steady search momentum.</p>
          </div>
        </div>
      </section>

      <!-- CALL TO ACTION CONTAINER -->
      <div class="bg-slate-900 text-white dark:bg-slate-900/90 border border-slate-800 rounded-3xl p-8 sm:p-10 text-left shadow-2xl relative overflow-hidden mt-8" transition:animate="fade">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue-500/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="max-w-2xl">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 block mb-2">// Get In Touch</span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">Planning a website project or looking for more inbound leads?</h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            Let’s review your current digital footprint and see where we can make the biggest impact. Connect directly on LinkedIn or reach out via Ace Marketing Solutions.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a 
              href="https://th.linkedin.com/in/phill-savage" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-mono font-bold uppercase tracking-wider text-slate-900 bg-white hover:bg-slate-100 rounded-lg transition-colors text-center shadow-lg"
            >
              Connect on LinkedIn →
            </a>
            <a 
              href="https://acemsthailand.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-mono font-bold uppercase tracking-wider text-white border border-slate-700 hover:border-slate-500 rounded-lg transition-colors text-center"
            >
              Visit Ace Marketing Solutions
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>