---
import BaseLayout from '../layouts/BaseLayout.astro';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Phill Savage",
    "jobTitle": "Retreat Director & Digital Strategist",
    "url": "https://psavage.net",
    "image": "https://psavage.net/images/phill.jpg",
    "description": "Retreat Director at Offsite Thailand and Director at Ace Marketing Solutions. Helping remote and hybrid teams resolve friction and rebuild alignment through corporate retreats in Chiang Mai.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Chiang Mai",
      "addressCountry": "TH"
    },
    "worksFor": [
      {
        "@type": "Organization",
        "name": "Offsite Thailand",
        "url": "https://offsitethailand.com"
      },
      {
        "@type": "Organization",
        "name": "Ace Marketing Solutions",
        "url": "https://acemsthailand.com"
      }
    ],
    "sameAs": [
      "https://offsitethailand.com",
      "https://acemsthailand.com",
      "https://x.com/savphill",
      "https://th.linkedin.com/in/phill-savage"
    ]
  }
};
---

<BaseLayout 
  title="About Phill Savage | Retreat Director & Digital Strategist" 
  description="About Phill Savage — Retreat Director at Offsite Thailand and Director at Ace Marketing Solutions in Chiang Mai. Resolving remote team friction through curated corporate retreats."
  keywords={["Phill Savage", "Offsite Thailand", "Corporate Retreats Chiang Mai", "Ace Marketing Solutions", "Remote Team Building"]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
      
      <!-- HERO HEADER -->
      <header class="mb-12">
        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mb-6">
          <img 
            src="/images/phill.jpg" 
            alt="Phill Savage" 
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover ring-2 ring-slate-200 dark:ring-slate-800 shadow-md flex-shrink-0"
          />
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
              Phill Savage
            </h1>
            <p class="text-sm font-mono text-slate-500 dark:text-slate-400 mt-1">
              Retreat Director at Offsite Thailand • Chiang Mai
            </p>
          </div>
        </div>
      </header>

      <!-- MAIN BIO / PROSE STORY -->
      <div class="space-y-6 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
        <p>
          I’ve spent over ten years in web development, technical SEO, and digital strategy. As Director at <a href="https://acemsthailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Ace Marketing Solutions</a>, much of my work focused on the hospitality sector—building web platforms and managing search visibility for global brands like Hyatt Corporation alongside regional hotel groups.
        </p>

        <p>
          Along the way, I also spent a lot of time in open-source security research, finding vulnerabilities in WordPress core and WooCommerce. I've always enjoyed dissecting complex systems to see where they break down under pressure.
        </p>

        <p>
          Managing large-scale web builds meant constantly coordinating with distributed teams, external vendors, and remote agencies across different time zones. And no matter the company size or stack, remote collaboration always hit the exact same walls. Communication fell apart in Slack, roadmaps drifted, and people got burnt out on camera-off calls.
        </p>

        <p>
          I spent years trying to solve those bottlenecks with better software, stricter SOPs, and automated workflows. But after a while, the lesson was clear: you can’t fix a human connection problem with another software tool. The quickest way to clear up team friction and get everyone moving in the same direction is still putting people in the same room.
        </p>

        <p>
          That’s what led me to my current role as Retreat Director at <a href="https://offsitethailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Offsite Thailand</a>. Working alongside <a href="https://boutiqthailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Boutiq Hospitality</a> in Chiang Mai, we host retreats that help remote and hybrid teams get out from behind their monitors, fix their communication issues, and build real trust face-to-face.
        </p>

        <p>
          If your team is dealing with remote friction or planning your next offsite, feel free to connect on <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">LinkedIn</a> or check out <a href="https://offsitethailand.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900 dark:hover:text-white transition-colors">Offsite Thailand</a>.
        </p>
      </div>

      <!-- FOOTER LINKS -->
      <div class="flex items-center gap-5 mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 text-sm font-medium text-slate-500 dark:text-slate-400">
        <a href="https://offsitethailand.com" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">Offsite Thailand</a>
        <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">LinkedIn</a>
        <a href="https://x.com/savphill" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">X</a>
      </div>

    </div>
  </div>
</BaseLayout>