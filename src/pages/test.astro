---
import BaseLayout from '../layouts/BaseLayout.astro';
const strategistSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Phill Savage",
  "url": "https://psavage.net",
  "image": "https://psavage.net/images/phill.jpg",
  "description": "Fixes messy business processes with AI and automation, usually on too much coffee.",
  "worksFor": {
    "@type": "Organization",
    "name": "Ace Marketing Solutions",
    "url": "https://acemsthailand.com"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chiang Mai",
    "addressCountry": "TH"
  },
  "sameAs": [
    "https://acemsthailand.com",
    "https://x.com/savphill",
    "https://th.linkedin.com/in/phill-savage"
  ]
};
---
<BaseLayout
  title="Phill Savage"
  description="I fix messy business processes with AI and automation, usually on too much coffee."
  keywords={["Digital Transformation", "AI Automation", "Process Design", "Chiang Mai"]}
  schema={strategistSchema}
>
  <div class="min-h-[80vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 py-20 text-left">
      <div class="relative w-fit mb-6">
        <img
          src="/images/phill.jpg"
          alt="Phill Savage"
          width="88"
          height="88"
          class="w-20 h-20 rounded-full object-cover ring-1 ring-slate-200 dark:ring-slate-700"
        />
        <!-- little steam wisps off the corner, because coffee -->
        <span class="absolute -top-2 -right-2 text-lg select-none" aria-hidden="true">☕</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">
        Phill Savage
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        I fix messy business processes — the manual, held-together-with-hope kind — usually with AI, some automation, and more coffee than is strictly advisable. I live in Chiang Mai and work alongside <a href="https://acemsthailand.com" target="_blank" rel="noopener noreferrer" class="underline decoration-slate-300 dark:decoration-slate-600 hover:decoration-blue-500 underline-offset-2">Ace Marketing Solutions</a>. I'm reasonably good at spreadsheets and occasionally over-engineer them out of pure spite for manual data entry.
      </p>
      <p class="text-sm text-slate-400 dark:text-slate-500 mt-4 italic flex items-center gap-2">
        Current caffeine level:
        <span id="caffeine-status" class="not-italic font-medium text-slate-500 dark:text-slate-400">loading…</span>
        <span class="inline-block w-16 h-1.5 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
          <span id="caffeine-bar" class="block h-full bg-gradient-to-r from-amber-600 to-slate-700 dark:from-amber-500 dark:to-slate-400 transition-all duration-700" style="width:0%"></span>
        </span>
      </p>
      <div class="flex items-center gap-5 mt-8 text-sm font-medium text-slate-500 dark:text-slate-400">
        <a href="mailto:hello@psavage.net" class="hover:text-slate-900 dark:hover:text-white transition-colors">Say hi</a>
        <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">LinkedIn</a>
        <a href="https://x.com/savphill" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">X</a>
        <a href="/posts" class="hover:text-slate-900 dark:hover:text-white transition-colors">Writing</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Fake but plausible caffeine decay, based on time of day.
  // Assumes coffees around 8am and 1pm, half-life ~5h.
  const HALF_LIFE_HOURS = 5;
  const DOSES = [8, 13]; // hours of day you typically drink coffee
  const DOSE_MG = 95;
  const MAX_MG = 190;

  function levelNow(): number {
    const now = new Date();
    const hourNow = now.getHours() + now.getMinutes() / 60;

    return DOSES.reduce((total, doseHour) => {
      let elapsed = hourNow - doseHour;
      if (elapsed < 0) elapsed += 24; // dose was "yesterday" relative to now
      return total + DOSE_MG * Math.pow(0.5, elapsed / HALF_LIFE_HOURS);
    }, 0);
  }

  function labelFor(pct: number): string {
    if (pct > 80) return "concerning";
    if (pct > 55) return "fully operational";
    if (pct > 30) return "functional";
    if (pct > 10) return "fading";
    return "please send coffee";
  }

  function render() {
    const mg = levelNow();
    const pct = Math.min(100, Math.round((mg / MAX_MG) * 100));
    const statusEl = document.getElementById("caffeine-status");
    const barEl = document.getElementById("caffeine-bar");
    if (statusEl) statusEl.textContent = labelFor(pct);
    if (barEl) barEl.style.width = `${pct}%`;
  }

  render();
  setInterval(render, 60_000);
</script>