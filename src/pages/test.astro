---
import BaseLayout from '../layouts/BaseLayout.astro';

const strategistSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Phill Savage",
  "url": "https://psavage.net",
  "image": "https://psavage.net/images/phill.jpg",
  "description": "Founder of Offsite Thailand, designing corporate retreats that help distributed teams reconnect.",
  "worksFor": {
    "@type": "Organization",
    "name": "Offsite Thailand"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chiang Mai",
    "addressCountry": "TH"
  },
  "sameAs": [
    "https://acemsthailand.com",
    "https://x.com/savphill",
    "https://th.linkedin.com/in/phill-savage"
  ]
};
---

<BaseLayout
  title="Phill Savage"
  description="Founder of Offsite Thailand — corporate retreats that help distributed teams reconnect."
  keywords={["Corporate Retreats", "Offsite Planning", "Digital Transformation", "Chiang Mai", "Thailand"]}
  schema={strategistSchema}
>
  <div class="min-h-[80vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 py-20 text-left">

      <img
        src="/images/phill.jpg"
        alt="Phill Savage"
        width="88"
        height="88"
        class="w-20 h-20 rounded-full object-cover mb-6 ring-1 ring-slate-200 dark:ring-slate-700"
      />

      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">
        Phill Savage
      </h1>

      <div class="space-y-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        <p>Hello, I'm Phill. I live in Chiang Mai, Thailand.</p>
        <p>After spending years helping remote teams fix their digital workflows, I realized the best way to solve team friction is to get everyone in the same room.</p>
        <p>That's why I created Offsite Thailand. Along with Boutiq Hospitality, we design corporate retreats that help distributed teams actually reconnect.</p>
      </div>

      <div class="flex items-center gap-5 mt-8 text-sm font-medium text-slate-500 dark:text-slate-400">
        <a href="mailto:hello@psavage.net" class="hover:text-slate-900 dark:hover:text-white transition-colors">Say hi</a>
        <a href="https://th.linkedin.com/in/phill-savage" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">LinkedIn</a>
        <a href="https://x.com/savphill" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">X</a>
        <a href="/posts" class="hover:text-slate-900 dark:hover:text-white transition-colors">Writing</a>
      </div>

    </div>
  </div>
</BaseLayout>